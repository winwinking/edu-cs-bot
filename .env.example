# 复制为 .env 后按需修改；这里的值都是示例值，不是真实密钥
# .env 已在 .gitignore 里，不会被提交

# ---------- PostgreSQL ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=edu_cs_bot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
# SQLAlchemy async 引擎用的连接串，走 asyncpg 驱动
DATABASE_URL=postgresql+asyncpg://postgres:change_me_dev_password@postgres:5432/edu_cs_bot

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
# 宿主机映射端口特意避开默认的 6379：本机很容易另外装了一个原生 Redis 占用 6379，
# 脚本连 localhost:6379 时会悄悄连到那个而不是容器里的这个，排查起来很晕
REDIS_HOST_PORT=6380
REDIS_PASSWORD=
# 容器内部互联用的还是标准端口 6379，只有宿主机映射端口改了，这里不用动
REDIS_URL=redis://redis:6379/0

# ---------- RabbitMQ ----------
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change_me_dev_password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
RABBITMQ_URL=amqp://guest:change_me_dev_password@rabbitmq:5672/
MQ_PREFETCH_COUNT=32

# ---------- JWT ----------
JWT_SECRET=change_me_dev_secret_please_rotate
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------- LLM（通过改这几个变量切换 mock-llm / DeepSeek，代码不用改）----------
LLM_BASE_URL=http://mock-llm:8000/v1
LLM_API_KEY=sk-mock-placeholder
LLM_MODEL=mock-gpt
LLM_TIMEOUT_SECONDS=15

# ---------- mock-llm 行为配置（运行时可通过 POST /admin/config 覆盖）----------
MOCK_LLM_LATENCY_MS=300
MOCK_LLM_ERROR_RATE=0.0
MOCK_LLM_MODE=normal

# ---------- 知识库 ----------
# 目前只有 hash 一个实现（阶段二 1.5：确定性哈希向量，不依赖网络/模型）
EMBEDDING_PROVIDER=hash
# pgvector（默认，主路径）或 mock_knowledge（调用 mock-knowledge 的 /search）
RETRIEVER=pgvector
# 检索分数低于这个值就认为"没查到明确依据"，标定过程见 docs/phase2_threshold.md
KNOWLEDGE_MIN_SCORE=0.30
MOCK_KNOWLEDGE_BASE_URL=http://mock-knowledge:8000
MOCK_KNOWLEDGE_TIMEOUT_SECONDS=2
# mock_knowledge 的打分尺度和 pgvector 完全不同，必须单独标定；标定结果两组分数没有干净分开，
# 这是"宁可漏判也不误判"的保守取值，不是严格标定结果，见 docs/phase2_threshold.md
MOCK_KNOWLEDGE_MIN_SCORE=0.04

# ---------- 财务查询（阶段二 2.9） ----------
# worker <-> mock-finance 之间的服务令牌，不是用户登录 token；mock 用的假值，不是真实密钥
FINANCE_SERVICE_TOKEN=finance-mock-service-token
MOCK_FINANCE_BASE_URL=http://mock-finance:8000
FINANCE_TIMEOUT_SECONDS=1.5
MOCK_FINANCE_LATENCY_MS=50
MOCK_FINANCE_MODE=normal

# ---------- 平台指令与二次确认（阶段二 2.10） ----------
MOCK_PLATFORM_BASE_URL=http://mock-platform:8000
PLATFORM_TIMEOUT_SECONDS=3
MOCK_PLATFORM_LATENCY_MS=50
MOCK_PLATFORM_MODE=normal
# 待确认操作的有效期：超过这个时间还没确认就按超时处理
PENDING_ACTION_TTL_SECONDS=300

# ---------- 提醒调度（阶段三 2） ----------
# scheduler 每隔多少秒扫一次到期提醒；一次最多取多少条（FOR UPDATE SKIP LOCKED）
SCHEDULER_INTERVAL_SECONDS=1
SCHEDULER_BATCH_SIZE=100

# ---------- 限流（阶段三 4）----------
# 按用户：10 秒内最多这么多条；按机构：每秒最多这么多条。机构上限要设得足够大，
# 阶段四压测时不能被限流挡住
RATE_LIMIT_USER_PER_10S=20
RATE_LIMIT_TENANT_PER_SEC=2000

# ---------- Redis 断线重连（阶段三 4）----------
# gateway 订阅回复的 Redis 连接断开后，重连间隔从这个值开始每次翻倍，封顶在 max
REDIS_RECONNECT_MIN_SECONDS=0.5
REDIS_RECONNECT_MAX_SECONDS=30

# ---------- 熔断器（阶段三 5）----------
# LLM 和 mock-finance 各自独立：连续失败达到这个次数就熔断，熔断这么多秒后放一个试探请求
CB_FAILURE_THRESHOLD=5
CB_OPEN_SECONDS=30

# ---------- 重试（阶段三 5）----------
# openai SDK 自己的重试已经关掉（max_retries=0），这里的次数和退避是我们自己唯一的一层
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_SECONDS=0.3
FINANCE_MAX_RETRIES=1
FINANCE_RETRY_BACKOFF_SECONDS=0.2
FINANCE_RETRY_BACKOFF_JITTER_SECONDS=0.1
PLATFORM_MAX_RETRIES=2
PLATFORM_RETRY_BACKOFF_BASE_SECONDS=0.5

# ---------- 死信（阶段三 5）----------
# 消息头 x-retry-count 达到这个值还失败，直接进 inbound.dead，不再重新投回队列
DLQ_MAX_RETRIES=3

# ---------- 外部调用超时（秒）----------
# 对应硬性规则"所有外部调用必须有超时"：DB/Redis/MQ 建立连接都不能无限等
DB_CONNECT_TIMEOUT_SECONDS=5
REDIS_TIMEOUT_SECONDS=5
MQ_CONNECT_TIMEOUT_SECONDS=10

# ---------- 服务端口（宿主机映射端口，避免和本机其他服务冲突）----------
GATEWAY_HOST_PORT=8000
# worker/scheduler 在 docker-compose.yml 里映射的是从这个值开始的一段端口范围（分别是
# 8011-8019、8002-8009），不是单个固定端口——这样 `docker compose up -d --scale worker=N`
# 才能给每个副本都分到一个不冲突的宿主机端口，单实例时依然稳定拿到这里写的默认值
WORKER_HEALTH_HOST_PORT=8011
SCHEDULER_HEALTH_HOST_PORT=8002
MOCK_IM_HOST_PORT=8080
MOCK_LLM_HOST_PORT=8100
MOCK_KNOWLEDGE_HOST_PORT=8101
MOCK_PLATFORM_HOST_PORT=8102
MOCK_FINANCE_HOST_PORT=8103

# ---------- 应用行为 ----------
APP_ENV=development
LOG_LEVEL=INFO
# 单条消息内容最大长度，超出网关直接拒绝，不入队
WS_MESSAGE_MAX_LENGTH=2000
# 去重 key 的过期时间（秒），对应需求里的 24 小时
DEDUP_TTL_SECONDS=86400
# worker 组装 LLM 上下文时取最近几条历史消息
CONVERSATION_HISTORY_LIMIT=10
